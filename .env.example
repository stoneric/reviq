JDBC_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/reviq
DATABASE_USER=reviq
DATABASE_PASSWORD=replace-with-a-dedicated-password
PORT=8088
BIND_HOST=127.0.0.1
PUBLIC_ORIGIN=https://reviq.xyz
COOKIE_SECURE=true
# Empty key enables clearly labeled local evidence search only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
# Confirm these maximum prices before enabling any different model.
OPENAI_INPUT_USD_PER_MILLION=2.00
OPENAI_OUTPUT_USD_PER_MILLION=8.00
DAILY_BUDGET_USD=2.00
# Optional fresh-page retrieval when direct public fetching is blocked or lacks review markup.
EXA_API_KEY=
# Separate from the analysis budget; also capped at 100 provider requests/day.
EXA_DAILY_BUDGET_USD=0.10
